# B站 认证配置
# 从浏览器 Cookie 中获取（F12 → Application → Cookies → bilibili.com）
# 复制此文件为 .env 后填入真实值

SESSDATA=你的SESSDATA值
bili_jct=你的bili_jct值
buvid3=你的buvid3值

# 飞书应用认证配置（飞书云文档模式需要）
# 在 https://open.feishu.cn/app 创建应用后获取
LARK_APP_ID=你的飞书App ID
LARK_APP_SECRET=你的飞书App Secret

# NGA 认证配置（NGA 发布模式需要）
# 从浏览器 Cookie 中获取（F12 → Application → Cookies → bbs.nga.cn）
# 获取方式：在登录 NGA 后，执行以下 JavaScript 从控制台复制：
#   document.cookie
# 粘贴所有 Cookie 值到下方（完整复制 Name=Value 格式，用分号分隔）
# 注意：如果 Cookie 过期，需要重新执行以上步骤更新
NGA_COOKIE=ngaPassportUid=你的UID; ngacn0comUserInfo=...; ...
